// LBASky.ush
//
// The original's exterior sky (DrawSky in SOURCES/3DEXT/DRAWSKY.CPP): the cloud half of the island's sky/sea texture
// page tiled on a horizontal plane high above the island, fading into the fog color with distance, on a background
// of the fog color (the screen is cleared with it). Evaluated per pixel of a sky dome by intersecting the view ray
// with that plane, so the clouds have proper perspective at any camera angle.

#pragma once

// ViewDir: normalized direction from the camera. Positions in world centimetres. The original's camera always stays
// below the cloud plane; a free camera may not, so the plane is kept at least MinClearance above it.
float3 LBASkyColor(float3 ViewDir, float3 CameraPosition, float CloudHeight, float MinClearance, float TileSize, float2 DriftUV,
	Texture2D Clouds, SamplerState CloudsSampler, float3 FogColor, float FogStart, float FogEnd)
{
	// No branch, so the texture derivatives stay valid across the horizon; rays that never reach the plane are
	// fully fogged.
	const float Height = max(CloudHeight - CameraPosition.z, MinClearance);
	const float Distance = Height / max(ViewDir.z, 1e-3);
	const float2 Hit = CameraPosition.xy + ViewDir.xy * Distance;
	const float3 Cloud = Clouds.Sample(CloudsSampler, Hit / TileSize + DriftUV).rgb;

	float Fog = saturate((Distance - FogStart) / max(FogEnd - FogStart, 1.0));
	Fog = ViewDir.z <= 1e-3 ? 1.0 : Fog;
	return lerp(Cloud, FogColor, Fog);
}
