// LBAPlanet.ush
//
// Globe mode (ULBAPlanetSubsystem): the world is flat and still, only the view is round. Around the camera, the world
// stays flat out to a radius (Flat); past it, it bends down onto a sphere of the planet's radius: a point at Distance
// from the camera (horizontally) goes Distance - Flat along the sphere from the flat circle's edge, its height above
// the sea becoming height above the sphere. So the sea curves away to a horizon, and far islands sink below it as they
// tilt away, rising as they come close. Values come from MPC_LBA_Planet, written each frame from the camera:
//
//   PlanetBend          x: radius (cm), y: flat radius around the camera (cm), z: sea level (world Z), w: 1 when on
//   PlanetView          xyz: the camera (world)
//   PlanetViewPrevious  xyz: the camera last frame (world), for motion vectors
//   PlanetSeaMove       xyz: how far the sea disc (kept under the camera) moved since last frame

#pragma once

// World position offset of a point FromView (world position - the camera, horizontally flat world) for the camera
// View: where the bend puts it, minus where it is.
float3 LBAPlanetBendOffset(float3 FromView, float3 View, float4 Bend)
{
	const float Radius = max(Bend.x, 1.0);
	const float Distance = length(FromView.xy);
	const float Beyond = Distance - Bend.y;
	if (Bend.w <= 0.0 || Beyond <= 0.0)
	{
		return 0.0;
	}
	const float2 Along = FromView.xy / Distance;
	const float Height = View.z + FromView.z - Bend.z;
	// Past half way around, everything ends at the far side of the planet.
	const float Angle = min(Beyond / Radius, PI);
	const float Sin = sin(Angle);
	const float HalfSin = sin(0.5 * Angle);
	// Horizontally Flat + (Radius + Height) sin(Angle) from the camera instead of Distance; vertically
	// (Radius + Height)(cos(Angle) - 1) lower, written so they stay precise for small angles.
	const float Outward = Radius * (Sin - Angle) - (Beyond - Radius * Angle) + Height * Sin;
	const float Down = -2.0 * (Radius + Height) * HalfSin * HalfSin;
	return float3(Along * Outward, Down);
}

// Last frame's offset of a vertex of the sea disc. The disc stays under the camera, so a vertex isn't the same point of
// the sea from one frame to the next: it gets where its current point of the sea was last frame (the sea doesn't
// move), bent for last frame's camera. FromViewPrevious: the vertex's last frame position - last frame's camera.
float3 LBAPlanetSeaPreviousOffset(float3 FromViewPrevious, float3 ViewPrevious, float3 SeaMove, float4 Bend)
{
	return SeaMove + LBAPlanetBendOffset(FromViewPrevious + SeaMove, ViewPrevious, Bend);
}

// Up of the bent world at a point FromView (flat world position - the camera).
float3 LBAPlanetBentUp(float3 FromView, float4 Bend)
{
	const float Distance = length(FromView.xy);
	const float Beyond = Distance - Bend.y;
	if (Bend.w <= 0.0 || Beyond <= 0.0)
	{
		return float3(0.0, 0.0, 1.0);
	}
	const float Angle = min(Beyond / max(Bend.x, 1.0), PI);
	return float3(FromView.xy / Distance * sin(Angle), cos(Angle));
}

// A direction of the flat world at a point FromView (flat world position - the camera) turned with the bend's tilt
// there, as the bent view shows it: up becomes LBAPlanetBentUp (for normals of surfaces bent by LBAPlanetBendOffset).
float3 LBAPlanetBendVector(float3 FromView, float4 Bend, float3 Vector)
{
	const float Distance = length(FromView.xy);
	const float Beyond = Distance - Bend.y;
	if (Bend.w <= 0.0 || Beyond <= 0.0)
	{
		return Vector;
	}
	const float Angle = min(Beyond / max(Bend.x, 1.0), PI);
	// Turn about the horizontal axis across the way from the camera, away from it.
	const float2 Along = FromView.xy / Distance;
	const float3 Axis = float3(-Along.y, Along.x, 0.0);
	const float Cos = cos(Angle);
	const float Sin = sin(Angle);
	return Vector * Cos + cross(Axis, Vector) * Sin + Axis * dot(Axis, Vector) * (1.0 - Cos);
}

// Normal of the sea (world) at a point given by its flat world position, with small ripples laid out on the flat sea.
float3 LBAPlanetSeaNormal(float3 FromView, float2 Flat, float Time, float4 Bend, float RippleSlope)
{
	const float3 Up = LBAPlanetBentUp(FromView, Bend);

	// Ripples: a few deep water waves (cm), their slopes along X and Y.
	const float4 Lengths = float4(130.0, 230.0, 370.0, 610.0);
	const float2 Dirs[4] = { float2(0.94, 0.34), float2(-0.42, 0.91), float2(0.71, -0.70), float2(0.16, 0.99) };
	float2 Slope = 0.0;
	UNROLL
	for (int Index = 0; Index < 4; ++Index)
	{
		const float K = 2.0 * PI / Lengths[Index];
		const float Omega = sqrt(981.0 * K);
		Slope += Dirs[Index] * cos(K * dot(Dirs[Index], Flat) - Omega * Time) * (0.25 + 0.25 * Index);
	}
	Slope *= RippleSlope;
	const float3 Tangent = normalize(float3(1.0, 0.0, 0.0) - Up * Up.x);
	const float3 Bitangent = normalize(cross(Up, Tangent));
	return normalize(Up - Slope.x * Tangent - Slope.y * Bitangent);
}

// Post-process side: bent positions back to the flat world, where surface patterns are laid out -------------------

struct FLBAPlanetView
{
	float4 Bend;
	float3 View;
};

bool LBAPlanetBent(FLBAPlanetView P)
{
	return P.Bend.w > 0.0;
}

// Where a point of the bent view (world) is in the flat world: the bend undone.
float3 LBAPlanetUnbend(FLBAPlanetView P, float3 World)
{
	const float3 FromView = World - P.View;
	const float Distance = length(FromView.xy);
	const float Beyond = Distance - P.Bend.y;
	if (!LBAPlanetBent(P) || Beyond <= 0.0)
	{
		return World;
	}
	// From the center of the bend's sphere below the flat circle's edge: the angle along it and the height above it.
	const float Radius = max(P.Bend.x, 1.0);
	const float Up = World.z - (P.Bend.z - Radius);
	const float Angle = atan2(Beyond, Up);
	const float Height = sqrt(Beyond * Beyond + Up * Up) - Radius;
	return float3(P.View.xy + FromView.xy / Distance * (P.Bend.y + Radius * Angle), P.Bend.z + Height);
}

// A direction of the bent view (world) at a point of it, as it is in the flat world (the tilt of the bend undone).
float3 LBAPlanetUnbendVector(FLBAPlanetView P, float3 World, float3 Vector)
{
	const float3 Flat = LBAPlanetUnbend(P, World);
	const float3 Up = LBAPlanetBentUp(Flat - P.View, P.Bend);
	if (Up.z >= 1.0)
	{
		return Vector;
	}
	// Turn about the horizontal axis that takes Up back to +Z.
	const float3 Axis = normalize(cross(Up, float3(0.0, 0.0, 1.0)));
	const float Cos = Up.z;
	const float Sin = length(Up.xy);
	return Vector * Cos + cross(Axis, Vector) * Sin + Axis * dot(Axis, Vector) * (1.0 - Cos);
}
