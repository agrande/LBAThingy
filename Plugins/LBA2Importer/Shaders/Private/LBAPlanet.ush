// LBAPlanet.ush
//
// Globe mode (ULBAPlanetSubsystem): the world is flat and still, only the view is round. From the camera on, it bends
// down onto a sphere of the planet's radius, the camera on top: a point at Distance from the camera (horizontally)
// goes Distance along the sphere, its height above the sea becoming height above the sphere. So the sea curves away
// to a horizon, and far islands sink below it as they tilt away, rising as they come close. Values come from
// MPC_LBA_Planet, written each frame from the camera:
//
//   PlanetBend          x: radius (cm), y: unused (0), z: sea level (world Z), w: 1 when on
//   PlanetView          xyz: the camera (world)
//   PlanetViewPrevious  xyz: the camera last frame (world), for motion vectors
//   PlanetSeaMove       xyz: how far the sea disc (kept under the camera) moved since last frame
//   PlanetSkyBelow      rgb: how much sky the sea reflects below the flat horizon (0: none, the renderer has its own)

#pragma once

// World position offset of a point FromView (world position - the camera, horizontally flat world) for the camera
// View: where the bend puts it, minus where it is.
float3 LBAPlanetBendOffset(float3 FromView, float3 View, float4 Bend)
{
	const float Radius = max(Bend.x, 1.0);
	const float Distance = length(FromView.xy);
	if (Bend.w <= 0.0 || Distance <= 0.0)
	{
		return 0.0;
	}
#if !SHADOW_DEPTH_SHADER
	// Overhead captures of the flat world: the water info texture must see the ground where it is, not sunk for wherever
	// the camera was (its depths make the sea's waves die out at the shores, and stop it there).
	if (IsOrthoProjection())
	{
		return 0.0;
	}
#endif
	const float2 Along = FromView.xy / Distance;
	const float Height = View.z + FromView.z - Bend.z;
	// Past half way around, everything ends at the far side of the planet.
	const float Angle = min(Distance / Radius, PI);
	const float Sin = sin(Angle);
	const float HalfSin = sin(0.5 * Angle);
	// Horizontally (Radius + Height) sin(Angle) from the camera instead of Distance; vertically
	// (Radius + Height)(cos(Angle) - 1) lower, written so they stay precise for small angles.
	const float Outward = Radius * (Sin - Angle) - (Distance - Radius * Angle) + Height * Sin;
	const float Down = -2.0 * (Radius + Height) * HalfSin * HalfSin;
	return float3(Along * Outward, Down);
}

// Last frame's offset of a vertex of the sea disc. The disc stays under the camera, so a vertex isn't the same point of
// the sea from one frame to the next: it gets where its current point of the sea was last frame (the sea doesn't
// move), bent for last frame's camera. FromViewPrevious: the vertex's last frame position - last frame's camera.
float3 LBAPlanetSeaPreviousOffset(float3 FromViewPrevious, float3 ViewPrevious, float3 SeaMove, float4 Bend)
{
	return SeaMove + LBAPlanetBendOffset(FromViewPrevious + SeaMove, ViewPrevious, Bend);
}

// Up of the bent world at a point FromView (flat world position - the camera).
float3 LBAPlanetBentUp(float3 FromView, float4 Bend)
{
	const float Distance = length(FromView.xy);
	if (Bend.w <= 0.0 || Distance <= 0.0)
	{
		return float3(0.0, 0.0, 1.0);
	}
	const float Angle = min(Distance / max(Bend.x, 1.0), PI);
	return float3(FromView.xy / Distance * sin(Angle), cos(Angle));
}

// A direction of the flat world at a point FromView (flat world position - the camera) turned with the bend's tilt
// there, as the bent view shows it: up becomes LBAPlanetBentUp (for normals of surfaces bent by LBAPlanetBendOffset).
float3 LBAPlanetBendVector(float3 FromView, float4 Bend, float3 Vector)
{
	const float Distance = length(FromView.xy);
	if (Bend.w <= 0.0 || Distance <= 0.0)
	{
		return Vector;
	}
	const float Angle = min(Distance / max(Bend.x, 1.0), PI);
	// Turn about the horizontal axis across the way from the camera, away from it.
	const float2 Along = FromView.xy / Distance;
	const float3 Axis = float3(-Along.y, Along.x, 0.0);
	const float Cos = cos(Angle);
	const float Sin = sin(Angle);
	return Vector * Cos + cross(Axis, Vector) * Sin + Axis * dot(Axis, Vector) * (1.0 - Cos);
}

// The sky the sea reflects below the flat horizon. Its normals turn with the bend, so far water reflects directions
// under the flat world's horizon, where the sky light is black (as in the island levels: the land must not get light
// from below); on a small planet the sky goes on down there to its own horizon. The sea gives it off as light: the
// sky light sampled in LBAPlanetSeaSkyBelowDirection, times LBAPlanetSeaSkyBelowWeight. Normal: the sea's (world,
// bent); ToCamera: the camera vector (world).

// The sea's reflection mirrored above the flat horizon: the sky near the horizon stands for the sky below it.
float3 LBAPlanetSeaSkyBelowDirection(float3 Normal, float3 ToCamera)
{
	const float3 N = normalize(Normal);
	const float3 V = normalize(ToCamera);
	const float3 Reflected = 2.0 * dot(N, V) * N - V;
	return float3(Reflected.xy, abs(Reflected.z));
}

// How much of it the sea reflects: water's Fresnel (Schlick, F0 0.02) where the reflection goes below the horizon,
// the sky light's black edge softened like a slightly rough reflection; SkyBelow: PlanetSkyBelow (0: none).
float3 LBAPlanetSeaSkyBelowWeight(float3 Normal, float3 ToCamera, float3 SkyBelow)
{
	const float3 N = normalize(Normal);
	const float3 V = normalize(ToCamera);
	const float NoV = saturate(dot(N, V));
	const float3 Reflected = 2.0 * NoV * N - V;
	const float Fresnel = 0.02 + 0.98 * pow(1.0 - NoV, 5.0);
	return SkyBelow * Fresnel * saturate(0.5 - 8.0 * Reflected.z);
}

// Normal of the sea (world) at a point given by its flat world position, with small ripples laid out on the flat sea.
float3 LBAPlanetSeaNormal(float3 FromView, float2 Flat, float Time, float4 Bend, float RippleSlope)
{
	const float3 Up = LBAPlanetBentUp(FromView, Bend);

	// Ripples: a few deep water waves (cm), their slopes along X and Y.
	const float4 Lengths = float4(130.0, 230.0, 370.0, 610.0);
	const float2 Dirs[4] = { float2(0.94, 0.34), float2(-0.42, 0.91), float2(0.71, -0.70), float2(0.16, 0.99) };
	float2 Slope = 0.0;
	UNROLL
	for (int Index = 0; Index < 4; ++Index)
	{
		const float K = 2.0 * PI / Lengths[Index];
		const float Omega = sqrt(981.0 * K);
		Slope += Dirs[Index] * cos(K * dot(Dirs[Index], Flat) - Omega * Time) * (0.25 + 0.25 * Index);
	}
	Slope *= RippleSlope;
	const float3 Tangent = normalize(float3(1.0, 0.0, 0.0) - Up * Up.x);
	const float3 Bitangent = normalize(cross(Up, Tangent));
	return normalize(Up - Slope.x * Tangent - Slope.y * Bitangent);
}

// Post-process side: bent positions back to the flat world, where surface patterns are laid out -------------------

struct FLBAPlanetView
{
	float4 Bend;
	float3 View;
};

bool LBAPlanetBent(FLBAPlanetView P)
{
	return P.Bend.w > 0.0;
}

// Where a point of the bent view (world) is in the flat world: the bend undone.
float3 LBAPlanetUnbend(FLBAPlanetView P, float3 World)
{
	const float3 FromView = World - P.View;
	const float Distance = length(FromView.xy);
	if (!LBAPlanetBent(P) || Distance <= 0.0)
	{
		return World;
	}
	// From the center of the bend's sphere below the camera: the angle along it and the height above it.
	const float Radius = max(P.Bend.x, 1.0);
	const float Up = World.z - (P.Bend.z - Radius);
	const float Angle = atan2(Distance, Up);
	const float Height = sqrt(Distance * Distance + Up * Up) - Radius;
	return float3(P.View.xy + FromView.xy / Distance * (Radius * Angle), P.Bend.z + Height);
}

// A direction of the bent view (world) at a point of it, as it is in the flat world (the tilt of the bend undone).
float3 LBAPlanetUnbendVector(FLBAPlanetView P, float3 World, float3 Vector)
{
	const float3 Flat = LBAPlanetUnbend(P, World);
	const float3 Up = LBAPlanetBentUp(Flat - P.View, P.Bend);
	if (Up.z >= 1.0)
	{
		return Vector;
	}
	// Turn about the horizontal axis that takes Up back to +Z.
	const float3 Axis = normalize(cross(Up, float3(0.0, 0.0, 1.0)));
	const float Cos = Up.z;
	const float Sin = length(Up.xy);
	return Vector * Cos + cross(Axis, Vector) * Sin + Axis * dot(Axis, Vector) * (1.0 - Cos);
}

// Post-process side: each surface's own sun ---------------------------------------------------------------------------
//
// The renderer has one sun, the one seen from the camera's place (ULBAPlanetSubsystem::UpdateSun): it lights the whole
// view as if every surface stood where the camera is, so from the belt's sunset Citadel's cliffs went dark orange, and
// from Citadel the belt stayed in its daylight. Light belongs to the surface: LBAPlanetSunRelight gives each surface the
// sun of its own place, as the ratio of a simple model of the light there (sky light + sun on its normal) to the same
// model for the camera's place. Where the two places agree it is 1, so near surfaces keep their real light and shadows.
// The model, in the light that shows a base color as it is (lit flat ground in the opened island's level is 1):
//
//   light = (Ambient + (1 - Ambient) / sin(the level's sun elevation) * the sun's intensity scale (UpdateSun's)
//           * max(N . to the sun, 0) * the sun's color) * SunsetLight ^ sunset
//
// SunsetLight is measured: the light the renderer gives the belt's walls up close, relative to the model's, against
// the same for Citadel's harbour by day (the sunset sky light is far more orange and brighter than its sun alone).
//
// The sun's color reddens with the sunset, less on high surfaces: low sunlight is orange because of the air it crossed,
// and higher up there is less of it (the share left above the surface, exp(-height / SunsetTintHeight)). Only its hue:
// kept as bright as the sunset's, the palette's steep highlights would burn the paler walls white.
//
//   PlanetSunPlaces   xy: the pole, zw: where the sun stands overhead (flat world, cm)
//   PlanetSunAngles   angles from the pole where the sunset begins (x) and is complete (y); z: the sunset sun's
//                     elevation; w: the furthest the day sun goes from overhead (radians)
//   PlanetSunLight    x: sin of the level's sun elevation, y: SunGroundLight, z: SurfaceSunsetGain, w: SunsetTintHeight (cm)
//   PlanetSunTint     rgb: the sunset sun's tint, a: the sky light's share of lit flat ground (0: relighting off)
//   PlanetSunAmbient  rgb: SunsetLight, a: how much more of the light's color the look takes in the sunset (its
//                     LightTint; negative: a debug view, lba.Globe.SurfaceSunDebug)
//   PlanetSunCamera   xyz: towards the renderer's sun, w: the sunset its light and sky are in (UpdateSun)
//   PlanetSkyDayZenith   rgb: the day's sky at the top, shown high up instead of the sunset's; a: how much of it
//   PlanetSkyDayHorizon  rgb: the day's sky at the horizon; a: how far below level the horizon is (radians)

struct FLBAPlanetSun
{
	float4 Places;
	float4 Angles;
	float4 Light;
	float4 Tint;
	float4 Ambient;
	float4 Camera;
	float4 SkyZenith;
	float4 SkyHorizon;
};

bool LBAPlanetSunOn(FLBAPlanetSun Sun)
{
	return Sun.Tint.a > 0.0;
}

// Towards the sun at a place of the flat world, and how far into the sunset it is (as UpdateSun for the camera).
float3 LBAPlanetSunAt(FLBAPlanetSun Sun, float Radius, float2 Place, out float Sunset)
{
	const float2 ToOverhead = Sun.Places.zw - Place;
	const float Angle = min(length(ToOverhead) / Radius, Sun.Angles.w);
	const float2 Along = ToOverhead / max(length(ToOverhead), 1e-3);
	const float3 Day = float3(Along * sin(Angle), cos(Angle));
	const float2 ToPole = Sun.Places.xy - Place;
	Sunset = smoothstep(Sun.Angles.x, Sun.Angles.y, length(ToPole) / Radius);
	const float2 PoleAlong = ToPole / max(length(ToPole), 1e-3);
	const float3 Dusk = float3(PoleAlong * cos(Sun.Angles.z), sin(Sun.Angles.z));
	return normalize(lerp(Day, Dusk, Sunset));
}

// The model's light (see above) on a normal. Sunset: how far into the sunset the sun's strength and the sky are;
// Reddening: the sun's color.
float3 LBAPlanetSunModel(FLBAPlanetSun Sun, float3 ToSun, float Sunset, float Reddening, float3 Normal)
{
	const float LevelSine = max(Sun.Light.x, 0.01);
	const float Ground = min(pow(LevelSine / max(ToSun.z, 1e-3), Sun.Light.y), 1.0);
	const float Gain = lerp(1.0, Sun.Light.z, Sunset);
	const float Share = saturate(Sun.Tint.a);
	const float3 Luma = float3(0.2126, 0.7152, 0.0722);
	const float3 Sunlit = lerp(1.0, Sun.Tint.rgb, Sunset);
	const float3 Paler = lerp(1.0, Sun.Tint.rgb, Reddening);
	const float3 Color = Paler * dot(Sunlit, Luma) / max(dot(Paler, Luma), 1e-3);
	return (Share + (1.0 - Share) / LevelSine * Ground * Gain * saturate(dot(Normal, ToSun)) * Color) * pow(max(Sun.Ambient.rgb, 1e-3), Sunset);
}

// What the light of a surface at Flat (flat world position, LBAPlanetUnbend) with a flat world Normal is multiplied by
// to be its own place's; SunsetDelta: how much further into the sunset that place is than the camera's.
float3 LBAPlanetSunRelight(FLBAPlanetView P, FLBAPlanetSun Sun, float3 Flat, float3 Normal, out float SunsetDelta, out float3 OwnLight)
{
	SunsetDelta = 0.0;
	OwnLight = 1.0;
	if (!LBAPlanetBent(P) || !LBAPlanetSunOn(Sun))
	{
		return 1.0;
	}
	float Sunset;
	const float3 ToSun = LBAPlanetSunAt(Sun, max(P.Bend.x, 1.0), Flat.xy, Sunset);
	const float Height = max(Flat.z - P.Bend.z, 0.0);
	const float Reddening = Sunset * exp(-Height / max(Sun.Light.w, 1.0));
	const float3 Own = LBAPlanetSunModel(Sun, ToSun, Sunset, Reddening, Normal);
	const float3 Camera = LBAPlanetSunModel(Sun, Sun.Camera.xyz, Sun.Camera.w, Sun.Camera.w, Normal);
	SunsetDelta = Sunset - Sun.Camera.w;
	OwnLight = Own;
	return clamp(Own / max(Camera, 1e-3), 0.05, 8.0);
}

// Post-process side: the sea's colors by latitude ---------------------------------------------------------------------
//
// The sea's color is a hint of where one is: toward the belt in the north it pales to ice, toward the pole under the
// sun in the south its main tone turns to the teal of the desert's oasis. The cartoon water shows a slot of the
// island's sea texture recolored toward them (LBASeaColor, LBASeaRegions in the importer), tinted by its own place's
// sunset (LBAPlanetSeaSunset). Latitudes are measured on the flat map, whose distances from the pole are the planet's.
//
//   PlanetSeaFrame      world to the map: xy cos and sin of the turn about Z, zw the move (cm)
//   PlanetSeaIce        x: the latitude (degrees) where the ice starts, toward the equator; y: where it is all ice;
//                       z: how much (0: off)
//   PlanetSeaTurquoise  x, y: the same toward the pole; z: how much (0: off)
//   PlanetSeaSunset     rgb: the sea's tint in the sunset (lba.Globe.SeaSunsetTint); a: 0 off

#define LBA_SEA_ICE_STEPS 4
#define LBA_SEA_REGION_SLOTS (LBA_SEA_ICE_STEPS + 1)

struct FLBASeaRegions
{
	float4 Frame;
	float4 Ice;
	float4 Turquoise;
	float4 Sunset;
};

// How far toward its color the sea at a flat world point is, in slots of the atlas (ice: 0 to LBA_SEA_ICE_STEPS,
// turquoise: 0 to 1), and the first of those slots (ice 0, turquoise LBA_SEA_ICE_STEPS).
float LBASeaRegionLevel(FLBAPlanetView P, FLBASeaRegions R, float2 Flat, out int FirstSlot)
{
	FirstSlot = 0;
	if (R.Ice.z <= 0.0 && R.Turquoise.z <= 0.0)
	{
		return 0.0;
	}
	const float2 Map = float2(R.Frame.x * Flat.x - R.Frame.y * Flat.y, R.Frame.y * Flat.x + R.Frame.x * Flat.y) + R.Frame.zw;
	const float Latitude = abs(90.0 - degrees(length(Map) / max(P.Bend.x, 1.0)));
	const float Ice = R.Ice.z * smoothstep(R.Ice.x, R.Ice.y, Latitude);
	const float Turquoise = R.Turquoise.z * smoothstep(R.Turquoise.x, R.Turquoise.y, Latitude);
	FirstSlot = Ice >= Turquoise ? 0 : LBA_SEA_ICE_STEPS;
	return Ice >= Turquoise ? Ice * LBA_SEA_ICE_STEPS : Turquoise;
}

// The shaded sea's Color at a flat world point in its own place's sunset, wherever the camera is: pale ice and foam go
// peach, the more the paler (deep blue would only turn teal: it has next to no red to warm). The light the sea reflects
// can't give it: by day it has next to no red, so the renderer's orange sunset sky taken as a ratio to the day's burns
// its pale colors pink (red x10 to x35, measured at the belt with lba.Look.Debug 4 against lba.Globe.Sun 0).
float3 LBAPlanetSeaSunset(FLBAPlanetView P, FLBAPlanetSun Sun, FLBASeaRegions R, float2 Flat, float3 Color)
{
	if (!LBAPlanetBent(P) || !LBAPlanetSunOn(Sun) || R.Sunset.a <= 0.0)
	{
		return Color;
	}
	float Sunset;
	LBAPlanetSunAt(Sun, max(P.Bend.x, 1.0), Flat, Sunset);
	// Linear luminance: the sea's blue (56,140,176) about 0.23, the ice's pale blue (156,196,224) 0.53, white 1.
	const float Pale = saturate((dot(Color, float3(0.2126, 0.7152, 0.0722)) - 0.25) / 0.3);
	return Color * lerp(1.0, R.Sunset.rgb, Sunset * Pale);
}
