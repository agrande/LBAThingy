// LBAWaterCartoon.ush
//
// Cartoon water (LBACartoonWater in LBAPaletteShading.ush), in the spirit of
// stylized game water: the original's sea texture drifting and bent by the waves, flat bands of shade rows following
// the smoothed light (deep, reflections, distance), white foam lines along coasts, piers, hulls and anyone wading, and
// white sparkles where the sun glints. This file holds the settings and the foam pattern.

#pragma once

struct FLBACartoonWaterSettings
{
	float TileSize;		// world size of the sea texture (cm), like the original's tiling
	float CellSize;		// spacing of the randomly shifted, turned and mirrored copies of the texture (tiles)
	float Variation;	// 0: plain tiling, 1: no visible repetition (hex-tiling)
	float Transition;	// width of the scattered transition between copies (0: hard edges, 1: wide)
	float2 Drift;		// drift of the sea texture (cm/s)
	float Wobble;		// how far the waves bend the texture (cm per unit of surface normal tilt)
	float Smoothing;	// radius the light is averaged over (cm): larger gives broader, calmer bands
	float FoamWidth;	// reach of the foam from what stands in the water (cm); 0: no foam
	float FoamSpeed;	// foam lines leaving the shore per second
	float FoamBrightness;	// linear brightness of the foam and sparkles (1: white)
	float SparkleLight;	// glints this many times brighter than the water around them become white sparkles
};

uint LBASeaHash(int2 Cell)
{
	uint H = (uint(Cell.x) * 0x8DA6B343u) ^ (uint(Cell.y) * 0xD8163841u);
	H ^= H >> 16;
	H *= 0x7FEB352Du;
	H ^= H >> 15;
	H *= 0x846CA68Bu;
	H ^= H >> 16;
	return H;
}

// Color of the sea texture (Size x Size, tiling, with mips) at Texels (mip 0 texel units on the water), read texel by
// texel so it stays a palette color.
//  - No visible repetition (hex-tiling): three copies of the texture, each shifted, turned a quarter turn and
//    mirrored at random, are laid on a triangular grid of CellSize tiles. Each point has a weight for the three
//    copies around it, sharpened so most of the water shows one copy; where they blend, each world texel picks one
//    copy at random by weight, so the borders are a scatter of texels instead of a seam.
//  - No shimmering in the distance: the mip is picked from TexelsPerPixel, and between two mips each world texel of
//    the coarser one switches at random, so the change spreads instead of drawing a line.
float3 LBASeaColor(Texture2D Sea, int Size, float2 Texels, float TexelsPerPixel, FLBACartoonWaterSettings C)
{
	const int MaxMip = int(firstbithigh(uint(Size)));
	const float Lod = log2(max(TexelsPerPixel, 1.0));
	int Mip = int(floor(Lod));
	const float MipSwitch = (LBASeaHash(int2(floor(Texels * exp2(-float(Mip + 1)))) + int2(31, 57)) & 0xFFFFu) / 65535.0;
	Mip = min(Mip + (MipSwitch < frac(Lod) ? 1 : 0), MaxMip);
	const float MipScale = exp2(-float(Mip));
	const int MipSize = max(Size >> Mip, 1);

	float2 T = Texels;
	if (C.Variation > 0.0)
	{
		// Triangular grid (Heitz and Neyret 2018, Mikkelsen 2022): the three vertices around the point and their
		// barycentric weights.
		const float2 G = Texels / (max(C.CellSize, 0.1) * Size);
		const float2 Skewed = float2(G.x - 0.57735027 * G.y, 1.15470054 * G.y);
		const int2 Base = int2(floor(Skewed));
		const float2 F = frac(Skewed);
		const float Z = 1.0 - F.x - F.y;
		int2 V1, V2, V3;
		float3 W;
		if (Z > 0.0)
		{
			W = float3(Z, F.y, F.x);
			V1 = Base;
			V2 = Base + int2(0, 1);
			V3 = Base + int2(1, 0);
		}
		else
		{
			W = float3(-Z, 1.0 - F.y, 1.0 - F.x);
			V1 = Base + int2(1, 1);
			V2 = Base + int2(1, 0);
			V3 = Base + int2(0, 1);
		}
		W = pow(max(W, 0.0), lerp(16.0, 2.0, saturate(C.Transition)));
		W /= max(W.x + W.y + W.z, 1e-5);
		const float Pick = (LBASeaHash(int2(floor(Texels * MipScale)) + int2(9001, 77 + Mip)) & 0xFFFFu) / 65535.0;
		const uint H = LBASeaHash(Pick < W.x ? V1 : Pick < W.x + W.y ? V2 : V3);
		T.x = (H & 1u) ? -T.x : T.x;
		const uint Turns = (H >> 1) & 3u;
		T = Turns == 1u ? float2(-T.y, T.x) : Turns == 2u ? -T : Turns == 3u ? float2(T.y, -T.x) : T;
		T += float2((H >> 8) & 0xFFu, (H >> 16) & 0xFFu);
	}
	int2 Texel = int2(floor(T * MipScale));
	Texel = ((Texel % MipSize) + MipSize) % MipSize;
	return Sea.Load(int3(Texel, Mip)).rgb;
}

// Foam at Distance (cm) from the nearest thing standing in the water: a wavy line hugging it, and lines leaving it
// and thinning out. 1 on foam, 0 elsewhere.
float LBAFoam(float Distance, float2 P, float Time, FLBACartoonWaterSettings C)
{
	if (Distance >= C.FoamWidth)
	{
		return 0.0;
	}
	const float X = Distance / C.FoamWidth;
	const float Noise = 0.5 + 0.25 * sin(P.x * 0.031 + P.y * 0.017 + Time * 0.7) + 0.25 * sin(P.y * 0.043 - P.x * 0.011 - Time * 0.9);
	const float Hug = X < 0.067 + 0.05 * Noise ? 1.0 : 0.0;
	const float Phase = frac(Time * C.FoamSpeed + 0.2 * Noise);
	const float Leaving = abs(X - (0.35 + 0.65 * Phase)) < 0.02 * (1.0 - Phase) ? 1.0 : 0.0;
	return max(Hug, Leaving);
}
