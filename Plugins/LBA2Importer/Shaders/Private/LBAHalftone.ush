// LBAHalftone.ush
//
// World-space halftone screen: a 45 degree lattice of round dots that grow with brightness, like comics printed with
// a halftone screen. The dots merge into a checkerboard at half coverage and become holes beyond it.
//
// Like the fractal dither (LBADither3D.ush), the screen is attached to surfaces yet keeps about the same dot size on
// screen: it is drawn at the power-of-two world scale closest to the wanted dot spacing, and crossfades into the
// next scale up as the surface moves away. The next scale's dots are a subset of this one's, so the dots that stay
// keep their place and the others shrink away.
//
// Textures (generated by the importer, LBARenderingAssets.cpp):
//  Ramp: 256 x 1, the spot value above which a given fraction of the screen lies (coverage 0..1 along X).

#pragma once

#include "/Engine/Private/DoubleFloat.ush"

struct FLBAHalftoneSettings
{
	// Distance between neighbouring dots, in pixels.
	float DotPixels;
	// Edge sharpness: 1 gives about one pixel of anti-aliasing.
	float Contrast;
};

// 1 on the dots (cell corners and centre: a 45 degree lattice), 0 halfway between two of them.
float LBAHalftoneSpot(float2 CellUV)
{
	const float2 C = cos(CellUV * (2.0 * PI));
	return 0.5 + 0.5 * C.x * C.y;
}

// UV:       surface coordinates (world units).
// DUVDX/Y:  change of UV per pixel along the screen axes.
// Coverage: fraction of the surface the dots should cover.
// Returns 1 on the dots and 0 elsewhere, with anti-aliased edges.
float LBAGetHalftone(Texture2D Ramp, SamplerState RampSampler, FDFVector2 UV, float2 DUVDX, float2 DUVDY, float Coverage,
	FLBAHalftoneSettings S)
{
	if (Coverage <= 0.0 || Coverage >= 1.0)
	{
		return saturate(Coverage);
	}

	// Largest and smallest change of UV per pixel (singular values of the screen-to-surface Jacobian). The lattice
	// follows the smallest, so dots seen at grazing angles are squashed rather than enlarged; anti-aliasing follows
	// the largest.
	const float A = dot(DUVDX, DUVDX) + dot(DUVDY, DUVDY);
	const float Det = DUVDX.x * DUVDY.y - DUVDX.y * DUVDY.x;
	const float Root = sqrt(max(A * A - 4.0 * Det * Det, 0.0));
	const float MaxRate = sqrt(max((A + Root) * 0.5, 1e-24));
	const float MinRate = sqrt(max((A - Root) * 0.5, 1e-24));

	// Neighbouring dots are a cell diagonal apart / 2, so the cell is sqrt(2) times the dot spacing.
	const float LevelLog = log2(S.DotPixels * 1.41421356 * MinRate);
	const float Level = clamp(floor(LevelLog), -40.0, 40.0);
	const float Fade = smoothstep(0.0, 1.0, saturate(LevelLog - Level));

	const float FineCell = exp2(Level);
	const float2 FineUV = DFFracDemote(DFDivideByPow2(UV, FineCell.xx));
	const float2 CoarseUV = DFFracDemote(DFDivideByPow2(UV, (2.0 * FineCell).xx));
	const float Spot = lerp(LBAHalftoneSpot(FineUV), LBAHalftoneSpot(CoarseUV), Fade);

	const float Threshold = Ramp.SampleLevel(RampSampler, float2(Coverage * (255.0 / 256.0) + 0.5 / 256.0, 0.5), 0).r;

	// The spot value changes by up to pi per cell; cells per pixel along the fastest direction.
	const float Width = PI * MaxRate / FineCell / max(S.Contrast, 0.05);
	return saturate((Spot - Threshold) / max(Width, 1e-4) + 0.5);
}
