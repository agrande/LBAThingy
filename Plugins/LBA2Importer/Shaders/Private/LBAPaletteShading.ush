// LBAPaletteShading.ush
//
// Post-process (Scene Color After DOF) that brings back LBA2's palette shading on top of Unreal's lighting.
//
// It runs before TSR, where the scene color and the G-buffer line up pixel for pixel (the light is their ratio), and
// in linear HDR, which generated levels make equal to the displayed colors: manual exposure 1, no tone curve.
//
// The original renders in 256 colors. Every island palette (XPL resource) ships a shade table: for each palette color,
// the color it becomes in each of 16 shade rows, from darkest (0) to brightest (15), row 12 being the unlit color.
// Shading walks along those "shade paths", which mostly stay inside one 16-color ramp of the palette, so shadows and
// highlights shift hue the way the artists painted them. Dithered polygons mix two neighbouring rows.
//
// Here Unreal lights the scene as usual (Lumen GI, shadows, fog), then for every pixel:
//  1. The surface's palette color is found from its G-buffer base color (nearest palette color, 64^3 lookup).
//  2. The light the surface receives (scene luminance / base color luminance) picks a position along that
//     color's shade path, linearly like the original's Gouraud intensity: the two rows around it, and how far
//     between them it is.
//  3. A world-space dither chooses between the two rows, so the dots stick to surfaces as the camera moves, yet keep
//     the same size on screen: fractal dots (Surface-Stable Fractal Dithering, see LBADither3D.ush) or a halftone
//     screen (LBAHalftone.ush).
//  4. The light's color (GI bounce, colored lights, fog) is kept as a tint, and the result is blended with the
//     modern image by Strength.
//
// Water (Unreal's single layer water) has no palette color in the G-buffer: its color comes from scattering, and its
// base color is only foam. It is drawn as cartoon water instead (LBACartoonWater): the original's sea texture drifting
// and bent by the waves, each texel along its shade path, in flat bands of shade rows following the water's smoothed
// light relative to the sea's main color (WaterColor), with white foam lines along everything that stands in the water
// and sparkles where the sun glints.
//
// The same material makes both looks of generated levels. "Original" keeps the defaults: rows picked linearly, one
// row apart, small dots. "Enhanced" is graded: a contrast curve on the light, rows further apart for bolder dots,
// split toning, exposure and saturation (see MI_LBA_Look_Enhanced).
//
// Textures (generated by the importer, LBARenderingAssets.cpp):
//  Lut:    64^3 volume, red = palette index / 255 of the palette color nearest to an sRGB color (>> 2 per channel).
//  Shades: 256 x 18, sRGB bytes in a linear texture. Texel (Index, Row) is the color of palette index Index in shade
//          row Row (0..15); row 16 holds the palette itself; row 17's red, at (Row, 17), the palette's typical
//          brightness in shade row Row relative to the unshaded color, / LBA_BRIGHTNESS_SCALE.

#pragma once

#include "/Plugin/LBA2Importer/Private/LBADither3D.ush"
#include "/Plugin/LBA2Importer/Private/LBAHalftone.ush"
#include "/Plugin/LBA2Importer/Private/LBAPlanet.ush"
#include "/Plugin/LBA2Importer/Private/LBAWaterCartoon.ush"

#define LBA_SHADE_ROWS 16
#define LBA_PALETTE_ROW 16
#define LBA_BRIGHTNESS_ROW 17
#define LBA_BRIGHTNESS_SCALE 4.0
#define LBA_SHADINGMODEL_WATER 10	// SHADINGMODELID_SINGLELAYERWATER

float3 LBASrgbToLinear(float3 C)
{
	C = saturate(C);
	return select(C <= 0.04045, C / 12.92, pow((C + 0.055) / 1.055, 2.4));
}

float3 LBALinearToSrgb(float3 C)
{
	C = max(C, 0.0);
	return select(C <= 0.0031308, C * 12.92, 1.055 * pow(C, 1.0 / 2.4) - 0.055);
}

float LBALuma(float3 Linear)
{
	return dot(Linear, float3(0.2126, 0.7152, 0.0722));
}

float3 LBAShadeColor(Texture2D Shades, uint Index, uint Row)
{
	return LBASrgbToLinear(Shades.Load(int3(Index, Row, 0)).rgb);
}

uint LBANearestPaletteIndex(Texture3D Lut, float3 LinearColor)
{
	const int3 Cell = int3(saturate(LBALinearToSrgb(LinearColor)) * 63.0 + 0.5);
	return uint(Lut.Load(int4(Cell, 0)).r * 255.0 + 0.5);
}

// Scene geometry ---------------------------------------------------------------------------------------------------

// Size of a pixel in viewport UV. PostProcessOutput only exists in post-process shaders; the cook also compiles the
// material's other shader types, and one failing permutation drops the whole material for the default one.
float2 LBAViewportPixelSize()
{
#if POST_PROCESS_MATERIAL
	return PostProcessOutput_ViewportSizeInverse;
#else
	return View.ViewSizeAndInvSize.zw;
#endif
}

float LBASceneDepthAt(float2 ViewportUV)
{
	return SceneTextureLookup(ViewportUVToSceneTextureUV(ViewportUV, PPI_SceneDepth), PPI_SceneDepth, false).r;
}

// Positions use the frame's jittered projection, like the scene color: TSR then sees the dots as surface detail.
float3 LBATranslatedPositionAt(float2 ViewportUV, float Depth)
{
	const float2 ScreenPos = ViewportUVToScreenPos(ViewportUV);
	return mul(float4(GetScreenPositionForProjectionType(ScreenPos, Depth), Depth, 1.0), View.ScreenToTranslatedWorld).xyz;
}

// Change of position towards one screen neighbour. Uses the side whose depth is closest to the centre, so the
// difference stays on the same surface at silhouettes (a difference across an edge would pick a far too coarse dot
// level all along every outline).
float3 LBASurfaceDelta(float2 ViewportUV, float2 Step, float3 Center, float CenterDepth)
{
	const float2 UVA = saturate(ViewportUV + Step);
	const float2 UVB = saturate(ViewportUV - Step);
	const float DepthA = LBASceneDepthAt(UVA);
	const float DepthB = LBASceneDepthAt(UVB);
	const bool bUseA = abs(DepthA - CenterDepth) <= abs(DepthB - CenterDepth);
	return bUseA
		? LBATranslatedPositionAt(UVA, DepthA) - Center
		: Center - LBATranslatedPositionAt(UVB, DepthB);
}

struct FLBADitherFrame
{
	FDFVector2 UV;
	float2 DUVDX;
	float2 DUVDY;
};

// World-aligned dither frame: the world position projected along the dominant axis of the geometric normal (taken
// from depth, so normal maps don't break the projection up). Dots are spaced in centimetres of world space. In globe
// mode, of the flat world where the view bends (LBAPlanet.ush), so they stay put on far surfaces as the camera moves.
FLBADitherFrame LBADitherSurfaceFrame(float2 ViewportUV, float Depth, float2 PixelSize, FLBAPlanetView Planet)
{
	const float3 Center = LBATranslatedPositionAt(ViewportUV, Depth);
	float3 DPDX = LBASurfaceDelta(ViewportUV, float2(PixelSize.x, 0.0), Center, Depth);
	float3 DPDY = LBASurfaceDelta(ViewportUV, float2(0.0, PixelSize.y), Center, Depth);
	FDFVector3 WorldPos = DFFastSubtract(Center, PrimaryView.PreViewTranslation);
	const float3 World = DFDemote(WorldPos);
	if (LBAPlanetBent(Planet))
	{
		const float3 Flat = LBAPlanetUnbend(Planet, World);
		DPDX = LBAPlanetUnbend(Planet, World + DPDX) - Flat;
		DPDY = LBAPlanetUnbend(Planet, World + DPDY) - Flat;
		WorldPos = DFPromote(Flat);
	}
	const float3 Axis = abs(cross(DPDX, DPDY));

	FLBADitherFrame Frame;
	if (Axis.x >= Axis.y && Axis.x >= Axis.z)
	{
		Frame.UV = MakeDFVector2(WorldPos.High.yz, WorldPos.Low.yz);
		Frame.DUVDX = DPDX.yz;
		Frame.DUVDY = DPDY.yz;
	}
	else if (Axis.y >= Axis.z)
	{
		Frame.UV = MakeDFVector2(WorldPos.High.xz, WorldPos.Low.xz);
		Frame.DUVDX = DPDX.xz;
		Frame.DUVDY = DPDY.xz;
	}
	else
	{
		Frame.UV = MakeDFVector2(WorldPos.High.xy, WorldPos.Low.xy);
		Frame.DUVDX = DPDX.xy;
		Frame.DUVDY = DPDY.xy;
	}
	return Frame;
}

// Unreal's height fog ----------------------------------------------------------------------------------------------

// Unreal fogs opaque surfaces before any post-process material runs, so the palette shading would read the fog as
// light. The fog is evaluated again here from the level's fog settings to take it out before shading and put it back
// after:
//  - Beyond the volumetric fog distance, GetExponentialHeightFog (HeightFogCommon.ush) for one fog layer, without
//    inscattering cubemap, sky light capture or sky atmosphere contribution, which generated levels don't use.
//  - Closer, the volumetric fog (VolumetricFog.usf): the same density field halved (MatchHeightFogFactor), in
//    natural exponents, lit with the height fog's colors (bOverrideLightColorsWithFogInscatteringColors, without
//    Lumen's translucency volume): the fog color through a constant SH (SHAmbientFunction, 1 / (2 sqrt(pi))) and the
//    sun with a Henyey-Greenstein phase. Its shadows, the light shafts, are the only difference left in the light.
struct FLBAHeightFog
{
	float Density;			// FogDensity / 1000 (0: no fog)
	float HeightFalloff;	// FogHeightFalloff / 1000
	float Height;			// height of the fog actor (cm)
	float StartDistance;
	float MaxOpacity;
	float3 Inscattering;	// FogInscatteringLuminance
	float3 SunInscattering;	// DirectionalInscatteringLuminance * luminance of the sun's color and intensity
	float SunExponent;
	float SunStartDistance;
	float VolumetricStart;		// VolumetricFogStartDistance
	float VolumetricDistance;	// 0: no volumetric fog
	float VolumetricPhaseG;		// VolumetricFogScatteringDistribution
};

// Integral of the fog density along a ray of RayLength from OriginHeight rising by RayDirectionZ, per unit length.
float LBAHeightFogDensityIntegral(float OriginHeight, float RayDirectionZ, FLBAHeightFog F)
{
	const float OriginTerms = F.Density * exp2(-max(-127.0, F.HeightFalloff * (OriginHeight - F.Height)));
	const float Falloff = max(-127.0, F.HeightFalloff * RayDirectionZ);
	return OriginTerms * (abs(Falloff) > 1e-5 ? (1.0 - exp2(-Falloff)) / Falloff : log(2.0) - 0.5 * Pow2(log(2.0)) * Falloff);
}

// rgb: light scattered towards the camera, a: transmittance.
float4 LBAHeightFog(float3 CameraToReceiver, float CameraHeight, float3 SunDirection, FLBAHeightFog F)
{
	if (F.Density <= 0.0)
	{
		return float4(0.0, 0.0, 0.0, 1.0);
	}
	const float Length = max(length(CameraToReceiver), 1e-3);
	const float3 Direction = CameraToReceiver / Length;
	const float SunCosine = dot(Direction, SunDirection);

	// Volumetric fog, from its start distance.
	float4 Near = float4(0.0, 0.0, 0.0, 1.0);
	const float NearLength = min(F.VolumetricDistance, Length);
	const float NearStart = min(F.VolumetricStart, NearLength);
	if (NearLength > NearStart)
	{
		// The height fog's integral carries a factor ln 2 (its density is in base 2).
		const float Segment = NearLength - NearStart;
		const float Integral = LBAHeightFogDensityIntegral(CameraHeight + Direction.z * NearStart, Direction.z * Segment, F) * Segment / log(2.0);
		Near.a = exp(-0.5 * Integral);
		const float G = F.VolumetricPhaseG;
		const float Phase = (1.0 - G * G) / (4.0 * PI * pow(max(1.0 + G * G - 2.0 * G * SunCosine, 1e-4), 1.5));
		Near.rgb = (F.Inscattering * (0.5 / sqrt(PI)) + F.SunInscattering * Phase) * (1.0 - Near.a);
	}

	// Height fog, from the volumetric fog's end or the fog's start distance.
	const float Exclude = min(max(NearLength, F.StartDistance) / Length, 1.0);
	const float OriginHeight = CameraHeight + Exclude * CameraToReceiver.z;
	const float RayLength = (1.0 - Exclude) * Length;
	const float Shared = LBAHeightFogDensityIntegral(OriginHeight, (1.0 - Exclude) * CameraToReceiver.z, F);
	const float Transmittance = max(saturate(exp2(-Shared * RayLength)), 1.0 - F.MaxOpacity);
	const float SunTransmittance = saturate(exp2(-Shared * max(RayLength - F.SunStartDistance, 0.0)));
	const float SunLobe = pow(saturate(SunCosine), F.SunExponent) / (4.0 * PI);
	const float3 Far = F.Inscattering * (1.0 - Transmittance) + F.SunInscattering * SunLobe * (1.0 - SunTransmittance);

	// CombineVolumetricFog (HeightFogCommon.ush).
	return float4(Near.rgb + Far * Near.a, Near.a * Transmittance);
}

// Main entry -------------------------------------------------------------------------------------------------------

struct FLBAPaletteShadingSettings
{
	float Strength;			// 0: modern image, 1: palette shading
	float NeutralRow;		// shade row of the unshaded color (the palette's ShadeNormalLevel)
	float NeutralLight;		// light (pixel luminance / base color luminance) that shows the unshaded color
	float ShadeContrast;	// scales how far light moves away from the neutral row
	float LightContrast;	// power curve on the light around ContrastPivot: 1 like the original, more deepens the
							// shadows and brightens the highlights
	float ContrastPivot;	// light (relative to NeutralLight) the contrast curve keeps: the island's sunlit ground
	float RowStep;			// shade rows between the two colors a dither mixes: 1 like the original, more gives wider
							// bands of bolder dots
	float KeepLuminance;	// 0: the ramps' own brightness, like the original, 1: Unreal's brightness with the ramps' hue
	float DitherAmount;		// 0: smooth blend between shade rows, 1: dithered rows
	float DotPattern;		// 0: fractal dots (Dither3D), 1: halftone screen
	float LightTint;		// how much of the light's color (GI, colored lights, fog) tints the palette colors
	float3 ShadowTint;		// split toning: tint of surfaces in the shade, and of surfaces lit beyond the neutral light
	float ShadowTintAmount;
	float3 HighlightTint;
	float HighlightTintAmount;
	float Exposure;			// stops, applied to the whole image (sky and fog included) after shading
	float Contrast;			// contrast of the image around mid grey: 1 keeps it, more for punchier images
	float Saturation;		// 1 keeps the colors, more is more colorful
	float ExcludedStencil;	// custom stencil of moving objects: they get smooth shading instead of world dots
	float ArtStencil;		// custom stencil of pre-drawn art (interior bricks): its colors brighten alike, row by row
	float3 WaterColor;		// the sea's palette color (linear) water is shaded with; black: water keeps Unreal's look
	float WaterNeutralLight;// light of open water relative to WaterColor (water is darker than the original's sea)
	float WaterLightTint;	// LightTint of water: how much shallows, foam and reflections keep their own color
	float WaterStrength;	// palette shading strength on water, relative to Strength
	float WaterHighlightRange;	// light above open water's that water's brightest rows take (reflections roll off into it)
	float SkyDepth;			// pixels at least this far (cm) keep their color
	float3 FogColor;		// the original's distance fog, applied after shading like its fog tables (linear color)
	float FogStart;			// view depth (cm) where the fog starts, and where it is complete
	float FogEnd;
	float HeightFogAmount;	// 0: Unreal's height fog is taken off shaded surfaces (the original fog replaces it), 1: kept
	float DebugView;		// 0: off, 1: G-buffer base color, 2: matched palette color, 3: position along the shade path,
							// 4: surfaces without Unreal's fog
	FLBAHeightFog HeightFog;
	FLBADither3DSettings Dither;
	FLBAHalftoneSettings Halftone;
	FLBACartoonWaterSettings Cartoon;
	FLBAPlanetView Planet;		// globe mode: how the view bends onto the planet (LBAPlanet.ush)
};

// Viewport UV of the point at a horizontal world offset from a translated world position; false off screen.
bool LBAOffsetToViewportUV(float3 Translated, float2 Offset, out float2 UV)
{
	const float4 Clip = mul(float4(Translated + float3(Offset, 0.0), 1.0), View.TranslatedWorldToClip);
	UV = Clip.xy / max(Clip.w, 1e-4) * float2(0.5, -0.5) + 0.5;
	return Clip.w > 0.0 && all(UV >= 0.0) && all(UV <= 1.0);
}

bool LBAIsWaterAt(float2 UV)
{
	return abs(SceneTextureLookup(ViewportUVToSceneTextureUV(UV, PPI_ShadingModelID), PPI_ShadingModelID, false).r - LBA_SHADINGMODEL_WATER) < 0.5;
}

// Light of the water at a horizontal offset from a water pixel, with this pixel's fog taken off. Falls back to Display
// where that point isn't water (behind the pier).
float3 LBAWaterLightAt(float3 Translated, float2 Offset, float3 Display, float4 HeightFog)
{
	float2 UV;
	if (!LBAOffsetToViewportUV(Translated, Offset, UV) || !LBAIsWaterAt(UV))
	{
		return Display;
	}
	const float3 Color = SceneTextureLookup(ViewportUVToSceneTextureUV(UV, PPI_PostProcessInput0), PPI_PostProcessInput0, false).rgb;
	return max(Color - HeightFog.rgb, 0.0) / HeightFog.a;
}

// Whether something stands in the water at a horizontal offset from a water pixel: the screen shows another surface
// there, and that surface is about at the water's height (a pier's foot, the coast, a hull; not a pier top in front).
bool LBAWaterContactAt(float3 Translated, float2 Offset, float MaxHeight)
{
	float2 UV;
	if (!LBAOffsetToViewportUV(Translated, Offset, UV) || LBAIsWaterAt(UV))
	{
		return false;
	}
	const float3 Hit = LBATranslatedPositionAt(UV, LBASceneDepthAt(UV));
	return abs(Hit.z - Translated.z) < MaxHeight;
}

// Horizontal distance (cm) from a water pixel to the nearest thing standing in the water, searched in 8 directions up
// to Range (returns Range when nothing is that close).
float LBAWaterContactDistance(float3 Translated, float Range)
{
	const int Steps = 5;
	float Nearest = Range;
	LOOP
	for (int K = 0; K < 8; ++K)
	{
		const float Angle = K * (0.25 * PI);
		const float2 Dir = float2(cos(Angle), sin(Angle));
		float Lo = 0.0;
		float Hi = -1.0;
		LOOP
		for (int J = 1; J <= Steps; ++J)
		{
			const float R = Range * J / Steps;
			if (R >= Nearest)
			{
				break;
			}
			if (LBAWaterContactAt(Translated, Dir * R, Range))
			{
				Hi = R;
				break;
			}
			Lo = R;
		}
		if (Hi > 0.0)
		{
			UNROLL
			for (int B = 0; B < 2; ++B)
			{
				const float Mid = 0.5 * (Lo + Hi);
				if (LBAWaterContactAt(Translated, Dir * Mid, Range))
				{
					Hi = Mid;
				}
				else
				{
					Lo = Mid;
				}
			}
			Nearest = min(Nearest, Hi);
		}
	}
	return Nearest;
}

// Exposure, contrast and saturation, the same for every pixel so the sky, fog and surfaces stay coherent. Contrast
// bends the luminance around mid grey (like Unreal's color grading contrast) and keeps the hue.
float3 LBAGrade(float3 Color, FLBAPaletteShadingSettings S)
{
	Color *= exp2(S.Exposure);
	const float Y = LBALuma(Color);
	Color *= 0.18 * pow(max(Y, 0.0) / 0.18, S.Contrast) / max(Y, 1e-5);
	return max(lerp(LBALuma(Color).xxx, Color, S.Saturation), 0.0);
}

float3 LBASplitTone(float3 Tint, float Amount)
{
	return lerp(1.0, Tint / max(LBALuma(Tint), 1e-4), saturate(Amount));
}

// Shade row for a light (relative to the neutral light), and that light after the contrast curve. Like the original's
// Gouraud intensity, the light picks the row linearly: no light is row 0, the neutral light the normal row
// (ShadeNormalLevel, 12 in every island palette), and the last rows are highlights. LightContrast first bends it around
// the pivot, so sunlit ground keeps its row while shade gets darker and sun-facing slopes brighter. HighlightRange
// (water): light above the pivot rolls off into the highlight rows instead of clipping.
float LBALightToRow(float Ratio, FLBAPaletteShadingSettings S, float HighlightRange, out float Contrasted)
{
	const float Pivot = max(S.ContrastPivot, 0.05);
	Contrasted = Pivot * pow(max(Ratio, 0.0) / Pivot, S.LightContrast);
	if (HighlightRange > 0.0 && Contrasted > 1.0)
	{
		const float Above = Contrasted - 1.0;
		Contrasted = 1.0 + HighlightRange * Above / (Above + HighlightRange);
	}
	return clamp(S.NeutralRow * (1.0 + (Contrasted - 1.0) * S.ShadeContrast), 0.0, LBA_SHADE_ROWS - 1.0);
}

// Cartoon water, before fog. Display: this pixel's light; BaseColor: the sea color.
float3 LBACartoonWater(float2 ViewportUV, float Depth, float3 Display, float4 HeightFog, float3 BaseColor, float3 WorldNormal,
	uint Index, Texture3D Lut, Texture2D Shades, Texture2D SeaTexture, float HighlightRange, FLBAPaletteShadingSettings S)
{
	const FLBACartoonWaterSettings C = S.Cartoon;
	const float3 Translated = LBATranslatedPositionAt(ViewportUV, Depth);
	// Sea coordinates: world XY, in globe mode of the flat world where the view bends (LBAPlanet.ush).
	const float3 World = DFDemote(DFFastSubtract(Translated, PrimaryView.PreViewTranslation));
	const float2 P = LBAPlanetUnbend(S.Planet, World).xy;
	const float2 Bend = LBAPlanetBent(S.Planet) ? LBAPlanetUnbendVector(S.Planet, World, WorldNormal).xy : WorldNormal.xy;
	const float Time = View.GameTime;
	const float BaseLuma = max(LBALuma(BaseColor), 1e-4);
	// World size of a pixel on the water (its longest side, at grazing angles along the view): details smaller than a
	// few pixels fade out in the distance instead of shimmering.
	const FLBADitherFrame Frame = LBADitherSurfaceFrame(ViewportUV, Depth, LBAViewportPixelSize(), S.Planet);
	const float Footprint = max(length(Frame.DUVDX), length(Frame.DUVDY));
	const bool bNear = 3.0 * Footprint < C.Smoothing;

	// Flat bands: the light averaged around the pixel, so ripples don't break the bands up.
	float3 Smooth = Display;
	const float Radius = max(C.Smoothing, 3.0 * Footprint);
	if (C.Smoothing > 0.0)
	{
		Smooth = 2.0 * Display;
		Smooth += LBAWaterLightAt(Translated, float2(Radius, 0.0), Display, HeightFog);
		Smooth += LBAWaterLightAt(Translated, float2(-Radius, 0.0), Display, HeightFog);
		Smooth += LBAWaterLightAt(Translated, float2(0.0, Radius), Display, HeightFog);
		Smooth += LBAWaterLightAt(Translated, float2(0.0, -Radius), Display, HeightFog);
		Smooth /= 6.0;
	}
	float Contrasted;
	const float Light = LBALuma(Smooth) / BaseLuma;
	const float Row = LBALightToRow(Light / S.NeutralLight, S, HighlightRange, Contrasted);

	// The original's sea texture, drifting and bent by the waves; each texel keeps its palette color's shade path.
	uint TexIndex = Index;
	uint Width, Height;
	SeaTexture.GetDimensions(Width, Height);
	if (Width >= 16)
	{
		const float TexelsPerCm = float(Width) / max(C.TileSize, 1.0);
		const float TexelsPerPixel = Footprint * TexelsPerCm;
		const float Wobble = C.Wobble * saturate(1.5 - TexelsPerPixel);
		const float2 Texels = (P + C.Drift * Time + Bend * Wobble) * TexelsPerCm;
		TexIndex = LBANearestPaletteIndex(Lut, LBASeaColor(SeaTexture, int(Width), Texels, TexelsPerPixel, C));
	}
	float3 Color = LBAShadeColor(Shades, TexIndex, uint(round(Row)));

	// Light color and split toning, like the other surfaces.
	float3 Tint = (Smooth + 0.002) / (BaseColor * Light + 0.002);
	Tint = clamp(Tint / max(LBALuma(Tint), 1e-4), 0.0, 4.0);
	Color *= lerp(1.0, Tint, S.LightTint);
	Color *= LBASplitTone(S.ShadowTint, (1.0 - Contrasted) * S.ShadowTintAmount);
	Color *= LBASplitTone(S.HighlightTint, (Contrasted - 1.0) * S.HighlightTintAmount);

	// Foam and sparkles: the palette color nearest to white at the level's foam brightness (grey under the storm).
	const float3 White = LBAShadeColor(Shades, LBANearestPaletteIndex(Lut, saturate(C.FoamBrightness).xxx), LBA_PALETTE_ROW);
	if (bNear && LBALuma(Display) > C.SparkleLight * LBALuma(Smooth))
	{
		Color = White;
	}
	if (C.FoamWidth > 2.0 * Footprint && LBAFoam(LBAWaterContactDistance(Translated, C.FoamWidth), P, Time, C) > 0.5)
	{
		Color = White;
	}
	return Color;
}

float3 LBAPaletteShading(FMaterialPixelParameters Parameters, float3 SceneColor, float3 BaseColor, float Depth, float Stencil, float CustomDepth,
	float ShadingModel, float3 WorldNormal, Texture3D Lut, Texture2D Shades, Texture2D SeaTexture,
	Texture3D DitherTexture, SamplerState DitherSampler, Texture2D DitherRamp, SamplerState DitherRampSampler,
	Texture2D HalftoneRamp, SamplerState HalftoneRampSampler,
	FLBAPaletteShadingSettings S)
{
	const bool bWater = abs(ShadingModel - LBA_SHADINGMODEL_WATER) < 0.5 && any(S.WaterColor > 0.0);
	float HighlightRange = 0.0;
	if (bWater)
	{
		// Open water shows the sea's color, like the original's unshaded sea texture: the contrast curve turns around it.
		HighlightRange = max(S.WaterHighlightRange, 0.01);
		BaseColor = S.WaterColor;
		S.NeutralLight *= S.WaterNeutralLight;
		S.ContrastPivot = 1.0;
		S.LightTint = S.WaterLightTint;
		S.Strength *= S.WaterStrength;
	}

	// The sky and unlit surfaces (black base color in the G-buffer) already show palette colors as they are, and
	// fog themselves.
	BRANCH
	if (Depth >= S.SkyDepth || all(BaseColor <= 0.0))
	{
		return LBAGrade(SceneColor, S);
	}

	// Take Unreal's fog off the surface. Surfaces lost in it are left as they are, in the original's fog when Unreal's
	// is taken off.
	const float Fog = S.FogEnd > S.FogStart ? saturate((Depth - S.FogStart) / (S.FogEnd - S.FogStart)) : 0.0;
	const float2 ViewportUV = GetViewportUV(Parameters);
	const float3 CameraToReceiver = LBATranslatedPositionAt(ViewportUV, Depth) - PrimaryView.TranslatedWorldCameraOrigin;
	const float4 HeightFog = LBAHeightFog(CameraToReceiver, DFHackToFloat(PrimaryView.WorldCameraOrigin).z,
		View.AtmosphereLightDirection[0].xyz, S.HeightFog);
	BRANCH
	if (HeightFog.a < 0.02)
	{
		return LBAGrade(lerp(SceneColor, S.FogColor, Fog * (1.0 - S.HeightFogAmount)), S);
	}
	const float3 Display = max(SceneColor - HeightFog.rgb, 0.0) / HeightFog.a;
	BRANCH
	if (S.Strength <= 0.0 || Fog >= 1.0 || S.DebugView > 3.5)
	{
		const float3 Unfogged = S.DebugView > 3.5 ? Display : lerp(Display, S.FogColor, Fog);
		return LBAGrade(lerp(Unfogged, Unfogged * HeightFog.a + HeightFog.rgb, S.HeightFogAmount * (S.DebugView > 3.5 ? 0.0 : 1.0)), S);
	}
	BRANCH
	if (bWater && S.DebugView < 0.5)
	{
		const float3 Cartoon = LBACartoonWater(ViewportUV, Depth, Display, HeightFog, BaseColor, WorldNormal,
			LBANearestPaletteIndex(Lut, BaseColor), Lut, Shades, SeaTexture, HighlightRange, S);
		const float3 CartoonShaded = lerp(lerp(Display, Cartoon, S.Strength), S.FogColor, Fog);
		return LBAGrade(lerp(CartoonShaded, CartoonShaded * HeightFog.a + HeightFog.rgb, S.HeightFogAmount), S);
	}

	const float Y = LBALuma(Display);
	const uint Index = LBANearestPaletteIndex(Lut, BaseColor);

	// Light reaching the surface, relative to the light that shows its base color as it is, picks the shade row (water
	// only gets here in the debug views).
	const float BaseLuma = LBALuma(BaseColor);
	const float Light = Y / max(BaseLuma, 1e-4);
	const float Ratio = Light / S.NeutralLight;
	const float Pivot = max(S.ContrastPivot, 0.05);
	float Contrasted;
	const float Row = LBALightToRow(Ratio, S, HighlightRange, Contrasted);

	// The two rows to mix are RowStep apart, counted from the neutral row so the unshaded color stays reachable.
	const float Step = max(S.RowStep, 1.0);
	const float Band = floor((Row - S.NeutralRow) / Step);
	const float RowBelow = clamp(round(S.NeutralRow + Band * Step), 0.0, LBA_SHADE_ROWS - 1.0);
	const float RowAbove = clamp(round(S.NeutralRow + (Band + 1.0) * Step), 0.0, LBA_SHADE_ROWS - 1.0);
	const float Fraction = saturate((Row - RowBelow) / max(RowAbove - RowBelow, 1.0));
	float3 Below = LBAShadeColor(Shades, Index, uint(RowBelow));
	float3 Above = LBAShadeColor(Shades, Index, uint(RowAbove));
	const float3 PaletteColor = LBAShadeColor(Shades, Index, LBA_PALETTE_ROW);

	// Pre-drawn art (the interiors' bricks) is never shaded by the original, so its colors sit anywhere on their ramps,
	// and neighbours often belong to two ramps whose shade paths part in the highlights (a terracotta floor tile splits
	// into brown and cream). It takes the palette's typical brightness of each row instead, all its colors alike. The
	// custom stencil only counts where its depth is this pixel's (furniture in front of a wall is not the wall), and
	// a shade table without the brightness row (levels not reimported since) keeps the shade paths.
	const bool bArt = S.ArtStencil > 0.0 && abs(Stencil - S.ArtStencil) < 0.5 && abs(CustomDepth - Depth) <= max(1.0, Depth * 0.002)
		&& LBAShadeColor(Shades, uint(S.NeutralRow), LBA_BRIGHTNESS_ROW).r > 0.0;
	if (bArt)
	{
		Below = PaletteColor * LBAShadeColor(Shades, uint(RowBelow), LBA_BRIGHTNESS_ROW).r * LBA_BRIGHTNESS_SCALE;
		Above = PaletteColor * LBAShadeColor(Shades, uint(RowAbove), LBA_BRIGHTNESS_ROW).r * LBA_BRIGHTNESS_SCALE;
	}

	BRANCH
	if (S.DebugView > 0.5)
	{
		const float3 Matched = LBAShadeColor(Shades, Index, LBA_PALETTE_ROW);
		const float3 Debug = S.DebugView < 1.5 ? BaseColor : S.DebugView < 2.5 ? Matched : float3(Row / (LBA_SHADE_ROWS - 1.0), Ratio * 0.5, Fraction);
		return Debug;
	}

	// World-space dots between the two rows. Moving objects (excluded stencil) are shaded smoothly instead, since
	// dots stuck to the world would slide over them.
	float Mix = Fraction;
	const bool bExcluded = S.ExcludedStencil > 0.0 && abs(Stencil - S.ExcludedStencil) < 0.5;
	BRANCH
	if (S.DitherAmount > 0.0 && !bExcluded && Fraction > 0.0 && Fraction < 1.0)
	{
		const FLBADitherFrame Frame = LBADitherSurfaceFrame(ViewportUV, Depth, LBAViewportPixelSize(), S.Planet);
		float Dots;
		BRANCH
		if (S.DotPattern >= 0.5)
		{
			Dots = LBAGetHalftone(HalftoneRamp, HalftoneRampSampler, Frame.UV, Frame.DUVDX, Frame.DUVDY, Fraction, S.Halftone);
		}
		else
		{
			Dots = LBAGetDither3D(DitherTexture, DitherSampler, DitherRamp, DitherRampSampler,
				Frame.UV, Frame.DUVDX, Frame.DUVDY, Fraction, S.Dither);
		}
		Mix = lerp(Fraction, Dots, S.DitherAmount);
	}
	float3 Color = lerp(Below, Above, Mix);

	// Base colors that are not exactly a palette color (filtered or mipmapped textures, remake models) keep their own
	// hue: the shade path only contributes its shift relative to the palette color it was matched to.
	Color *= clamp((BaseColor + 0.004) / (PaletteColor + 0.004), 0.5, 2.0);

	// Light color: how the pixel differs from the base color lit by a white light of the same luminance.
	const float3 WhiteLit = BaseColor * Light;
	float3 Tint = (Display + 0.002) / (WhiteLit + 0.002);
	Tint = clamp(Tint / max(LBALuma(Tint), 1e-4), 0.0, 4.0);
	Color *= lerp(1.0, Tint, S.LightTint);

	// Split toning on either side of the pivot, from the smooth light so the tints don't follow the dots.
	Color *= LBASplitTone(S.ShadowTint, (1.0 - Contrasted / Pivot) * S.ShadowTintAmount);
	Color *= LBASplitTone(S.HighlightTint, (Contrasted / Pivot - 1.0) * S.HighlightTintAmount);

	// Light beyond the brightest row (HDR highlights, emissive) brightens the last shade instead of clipping to it,
	// and KeepLuminance trades the ramps' brightness for Unreal's (after the contrast curve), keeping only their hue.
	const float MaxRowLight = 1.0 + ((LBA_SHADE_ROWS - 1.0) / S.NeutralRow - 1.0) / max(S.ShadeContrast, 1e-3);
	Color *= max(Contrasted / MaxRowLight, 1.0);
	const float TargetLuma = Y * Contrasted / max(Ratio, 1e-4);
	Color *= lerp(1.0, TargetLuma / max(LBALuma(Color), 1e-5), S.KeepLuminance);

	const float3 Shaded = lerp(lerp(Display, Color, S.Strength), S.FogColor, Fog);
	return LBAGrade(lerp(Shaded, Shaded * HeightFog.a + HeightFog.rgb, S.HeightFogAmount), S);
}
