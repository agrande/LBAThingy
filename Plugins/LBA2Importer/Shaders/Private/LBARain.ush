// LBARain.ush
//
// The original's rain (RAIN.CPP): 200 drops drawn as Z-buffered lines in a box around the camera, falling fast and
// slanted by the wind, darker with distance (palette 58 near to 51 far), with a little splash where they hit something.
// Here:
//  - Drops are particles (NS_LBA_Rain, kept in view around the camera by Niagara's view recycler) drawn as streaks
//    by M_LBA_RainDrop: a drop's head is where the particle is, and its streak trails back along its path through the
//    world, whatever the camera does. Never thinner than a pixel (fainter instead, so they don't shimmer), darker with
//    distance, fading in the fog. Translucency after motion blur: composited after the palette shading, which would otherwise read them
//    as light on the surfaces behind.
//  - The level's density map thins the rain out where it is lighter (low ground): each drop has its own random
//    threshold, and only shows where the density is above it.
//  - With a storm (ALBAStorm), the drops fall through its wind: ULBAWindSubsystem gives them the wind at the camera.
//  - Splashes are rings on upward surfaces (ground, water) near the camera, a post-process after tonemapping
//    (M_LBA_Rain): each world cell has its own random drops (thinned out like the drops), and a ring grows and fades
//    where each one lands. Colors are display colors (sRGB), like the original's palette.

#pragma once

// Drops ---------------------------------------------------------------------------------------------------------------

// World size of a pixel at a view depth (cm).
float LBARainPixelAtDepth(float Depth)
{
	return max(Depth, 1.0) * 2.0 * View.ViewSizeAndInvSize.z / View.ViewToClip[0][0];
}

// Width a streak is drawn with: never thinner than MinPixels.
float LBARainDrawnWidth(float Width, float Depth, float MinPixels)
{
	return max(Width, MinPixels * LBARainPixelAtDepth(Depth));
}

// Rain density (0 to 1) at a world position, from a level's density map covering Bounds (min XY, 1 / size XY).
float LBARainDensity(Texture2D Map, SamplerState MapSampler, float2 Position, float4 Bounds)
{
	return Map.SampleLevel(MapSampler, (Position - Bounds.xy) * Bounds.zw, 0.0).r;
}

// How visible a drop with a random threshold (0 to 1) is where the rain has a density: it fades in over the last
// DensitySoftness of density below its threshold, and shows wherever the density is 1.
float LBARainDropVisibility(float Density, float Random)
{
	const float DensitySoftness = 0.05;
	return saturate((Density * (1.0 + DensitySoftness) - Random) / DensitySoftness);
}

// World position offset that redraws a drop's sprite as a streak: the drop's head stays where the particle is, and its
// streak trails back along its path (its velocity: Direction), Size.y long and at least MinPixels wide. Invisible drops
// collapse to a point. ToCamera: from the particle to the camera; VertexOffset: from the particle to the vertex;
// Direction: the particle's, along which Niagara built the sprite (Size: width, length).
float3 LBARainDropOffset(float3 ToCamera, float3 VertexOffset, float3 Direction, float2 Size, float MinPixels, float Visibility)
{
	BRANCH
	if (Visibility <= 0.0)
	{
		return -VertexOffset;
	}
	// Which corner this vertex is, on Niagara's sprite (the head stays the head).
	const float3 SpriteRight = normalize(cross(Direction, ToCamera) + 1e-6);
	const float Along = sign(dot(VertexOffset, Direction));
	const float Across = sign(dot(VertexOffset, SpriteRight));

	const float Depth = dot(-ToCamera, View.ViewForward);
	const float Width = LBARainDrawnWidth(Size.x, Depth, MinPixels);
	const float Length = max(Size.y, Width);
	return (Along > 0.0 ? 0.0 : -Length) * Direction + 0.5 * Across * Width * SpriteRight - VertexOffset;
}

// Color (linear) and opacity of a drop's pixel. UV: X across the streak, Y along it (1 at the drop's head). ToCamera:
// from the pixel to the camera. Streaks drawn wider than they are get fainter (less than in proportion: a thin line
// reads stronger than its area); their trail fades to TrailFade; the fog (natural extinction per cm past FogStart)
// fades them out. Visibility: see LBARainDropVisibility. Drops fade in and out over LifeFade of their life
// (RelativeTime, 0 to 1): Niagara recycles them in view when their life ends.
float4 LBARainDrop(float2 UV, float3 ToCamera, float Width, float MinPixels, float3 NearColor, float3 FarColor,
	float ColorDistance, float Opacity, float TrailFade, float FogDensity, float FogStart, float Visibility,
	float RelativeTime, float LifeFade)
{
	const float Distance = length(ToCamera);
	const float Depth = dot(-ToCamera, View.ViewForward);
	const float Coverage = sqrt(Width / LBARainDrawnWidth(Width, Depth, MinPixels));
	const float Across = saturate(2.0 * (1.0 - abs(2.0 * UV.x - 1.0)));
	const float Trail = lerp(TrailFade, 1.0, saturate(UV.y));
	const float Fog = exp(-FogDensity * max(Distance - FogStart, 0.0));
	const float3 Color = lerp(NearColor, FarColor, saturate(Distance / max(ColorDistance, 1.0)));
	const float Life = saturate(min(RelativeTime, 1.0 - RelativeTime) / max(LifeFade, 1e-3));
	return float4(Color, saturate(Opacity * Coverage * Across * Trail * Fog * Visibility * Life));
}

// Splashes ------------------------------------------------------------------------------------------------------------

struct FLBARainSettings
{
	float Amount;			// 0: no splashes
	float Opacity;
	float SplashRate;		// drops per m^2 per second hitting the ground near the camera
	float SplashRadius;		// cm, at the end of a splash
	float SplashDuration;	// seconds
	float SplashRange;		// cm from the camera
	float3 SplashColor;		// sRGB
	float4 DensityBounds;	// the density map's bounds (see LBARainDensity)
};

uint LBARainHashU(uint X)
{
	X ^= X >> 16;
	X *= 0x7feb352du;
	X ^= X >> 15;
	X *= 0x846ca68bu;
	X ^= X >> 16;
	return X;
}

float LBARainHash(int3 P, uint Salt)
{
	return LBARainHashU(asuint(P.x) ^ LBARainHashU(asuint(P.y) ^ LBARainHashU(asuint(P.z) ^ Salt))) / 4294967296.0;
}

// Coverage of a line of world width Width at a distance Distance from its axis, with the pixel's world size: thinner
// than a pixel, it is drawn one pixel wide and fainter.
float LBARainLine(float Distance, float Width, float Pixel)
{
	const float Drawn = max(Width, Pixel);
	return saturate((0.5 * Drawn + 0.5 * Pixel - Distance) / Pixel) * sqrt(Width / Drawn);
}

// Size of a pixel in viewport UV (see LBAViewportPixelSize: the cook also compiles the material's other shader types,
// so post-process only identifiers and screen derivatives stay under the guard).
float2 LBARainPixelSize()
{
#if POST_PROCESS_MATERIAL
	return PostProcessOutput_ViewportSizeInverse;
#else
	return View.ViewSizeAndInvSize.zw;
#endif
}

// Normal of the surface at a position, from screen derivatives.
float3 LBARainSurfaceNormal(float3 P)
{
#if POST_PROCESS_MATERIAL
	return normalize(cross(ddx(P), ddy(P)) + 1e-6);
#else
	return float3(0.0, 0.0, 1.0);
#endif
}

float3 LBARain(float2 ViewportUV, float3 SceneColor, float SceneDepth, Texture2D DensityMap, SamplerState DensityMapSampler,
	FLBARainSettings R)
{
	BRANCH
	if (R.Amount <= 0.0)
	{
		return SceneColor;
	}
	const float Time = View.GameTime;

	// View ray without the frame's jitter: the splashes are drawn after TSR.
	const float2 Ndc = (ViewportUV * 2.0 - 1.0) * float2(1.0, -1.0);
	const float3 ViewRay = float3(Ndc.x / View.ViewToClip[0][0], Ndc.y / View.ViewToClip[1][1], 1.0);
	const float3 Dir = normalize(mul(ViewRay, (float3x3)View.ViewToTranslatedWorld));
	const float ForwardCosine = dot(Dir, View.ViewForward);
	const float3 Camera = DFHackToFloat(PrimaryView.WorldCameraOrigin);
	// World size of a pixel per cm of view depth.
	const float PixelPerDepth = 2.0 * LBARainPixelSize().y / View.ViewToClip[1][1];

	float3 Color = SceneColor;

	// Splashes on what the pixel shows (its normal from screen derivatives, outside any branch).
	const float3 P = Camera + Dir * (SceneDepth / max(ForwardCosine, 1e-3));
	const float3 Normal = LBARainSurfaceNormal(P);
	BRANCH
	if (R.SplashRate > 0.0 && SceneDepth < R.SplashRange)
	{
		BRANCH
		if (abs(Normal.z) > 0.7)
		{
			const float CellSize = 4.0 * R.SplashRadius;
			const int2 Cell = int2(floor(P.xy / CellSize));
			// Drops per second in this cell; each cell keeps its own rhythm.
			const float Rate = R.SplashRate * Pow2(CellSize / 100.0);
			const float Clock = Time * Rate + LBARainHash(int3(Cell, 0), 11u);
			const int Drop = int(floor(Clock));
			const float Age = frac(Clock) / Rate;
			// Fewer drops where the rain is lighter, as for the falling ones.
			const float Density = LBARainDensity(DensityMap, DensityMapSampler, P.xy, R.DensityBounds);
			if (Age < R.SplashDuration && LBARainHash(int3(Cell, Drop), 14u) < Density)
			{
				const float2 Center = (float2(Cell) + 0.25 + 0.5 * float2(LBARainHash(int3(Cell, Drop), 12u), LBARainHash(int3(Cell, Drop), 13u))) * CellSize;
				const float Life = Age / R.SplashDuration;
				const float Ring = LBARainLine(abs(length(P.xy - Center) - R.SplashRadius * sqrt(Life)), 0.4, SceneDepth * PixelPerDepth);
				const float Fade = (1.0 - Life) * saturate(2.0 - 2.0 * SceneDepth / R.SplashRange);
				Color = lerp(Color, R.SplashColor, Ring * Fade * R.Opacity);
			}
		}
	}
	return Color;
}
